<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= title %> | GreenRoute</title>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main>
    <div class="page-wrap" style="max-width: 900px;">

      <div class="page-header">
        <h1>Manage Users</h1>
        <p>View and manage user accounts and their status</p>
      </div>

      <% if (locals.success) { %>
        <div class="alert alert--success"><%= success %></div>
      <% } %>
      <% if (locals.error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>

      <div class="card">
        <div class="card__label"><%= users ? users.length : 0 %> Users registered</div>

        <% if (!users || users.length === 0) { %>
          <div class="empty-state">
            <div class="empty-state__icon">👥</div>
            <h3>No users yet</h3>
            <p>Users will appear here once they register</p>
          </div>
        <% } else { %>
          <div class="journey-list">
            <% users.forEach(u => { %>
              <div class="journey-card" style="cursor: default;">
                <div>
                  <div class="journey-card__route"><%= u.name %></div>
                  <div class="journey-card__meta">
                    <span class="journey-card__tag">✉️ <%= u.email %></span>
                    <span class="journey-card__tag">
                      <span class="badge <%= u.role === 'admin' ? 'badge--blue' : 'badge--muted' %>">
                        <%= u.role %>
                      </span>
                    </span>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                  <span class="badge <%= (u.accountStatus === 'active' || !u.accountStatus) ? 'badge--green' : 'badge--red' %>">
                    <%= u.accountStatus || 'active' %>
                  </span>

                  <% if (u.accountStatus !== 'suspended') { %>
                    <form action="/api/users/<%= u._id %>/status?_method=PUT" method="POST">
                      <input type="hidden" name="status" value="suspended">
                      <button type="submit" class="btn btn--danger btn--sm">Suspend</button>
                    </form>
                  <% } else { %>
                    <form action="/api/users/<%= u._id %>/status?_method=PUT" method="POST">
                      <input type="hidden" name="status" value="active">
                      <button type="submit" class="btn btn--outline btn--sm">Activate</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
