<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= title %> | GreenRoute</title>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main>
    <div class="page-wrap">

      <div class="page-header">
        <h1>Admin Dashboard</h1>
        <p>Overview of platform usage</p>
      </div>

      <!-- Stats -->
      <div class="stats-row" style="padding: 0; margin-bottom: 20px;">
        <div class="stat-card animate-fade-up">
          <div class="stat-card__number"><%= stats?.usersCount ?? 0 %></div>
          <div class="stat-card__label">Total Users</div>
        </div>
        <div class="stat-card animate-fade-up">
          <div class="stat-card__number"><%= stats?.journeysCount ?? 0 %></div>
          <div class="stat-card__label">Total Journeys</div>
        </div>
        <div class="stat-card animate-fade-up">
          <div class="stat-card__number"><%= stats?.activeModesCount ?? 0 %></div>
          <div class="stat-card__label">Active Modes</div>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>