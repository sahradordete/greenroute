<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= title %> | GreenRoute</title>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main>
    <div class="page-wrap" style="max-width: 900px;">

      <div class="page-header">
        <h1>All Journeys</h1>
      </div>

      <div class="card">
        <div class="card__label"><%= journeys ? journeys.length : 0 %> Journeys recorded</div>

        <% if (!journeys || journeys.length === 0) { %>
          <div class="empty-state">
            <div class="empty-state__icon">🗺️</div>
            <h3>No journeys yet</h3>
            <p>Journeys will appear here once users start creating them</p>
          </div>
        <% } else { %>
          <div class="journey-list">
            <% journeys.forEach(j => { %>
              <div class="journey-card" style="cursor: default;">
                <div>
                  <div class="journey-card__route">
                    <%= j.origin || '—' %> → <%= j.destination || '—' %>
                  </div>
                  <div class="journey-card__meta">
                    <span class="journey-card__tag">
                      👤
                      <% if (j.userId && j.userId.name) { %>
                        <%= j.userId.name %> (<%= j.userId.email %>)
                      <% } else { %>
                        Unknown user
                      <% } %>
                    </span>
                    <span class="journey-card__tag">
                      🚌 <%= j.modeId && j.modeId.name ? j.modeId.name : '—' %>
                    </span>
                    <span class="journey-card__tag">
                      📍 <%= j.distanceKm ?? '—' %> km
                    </span>
                    <span class="journey-card__tag">
                      🕐 <%= j.createdAt ? new Date(j.createdAt).toLocaleDateString('en-GB') : '—' %>
                    </span>
                  </div>
                </div>

                <div class="journey-card__co2">
                  <div class="journey-card__co2-num"><%= j.estimatedEmissions ?? '—' %></div>
                  <div class="journey-card__co2-label">kg CO₂</div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
